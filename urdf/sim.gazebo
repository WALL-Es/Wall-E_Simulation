<?xml version="1.0" ?>
<robot name="sim" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="body_color" value="Gazebo/Silver" />

<gazebo reference="base_link">
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
  <gravity>true</gravity>
</gazebo>

<gazebo reference="Button_Head_Small_Solid_Rivet_ASME_B18.1.1_-_3/8_x_1_1/4_Steel_Plain_1">
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="Wheel2_1">
  <mu1>1.5</mu1>
  <mu2>1.5</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="Wheels_1">
  <mu1>1.5</mu1>
  <mu2>1.5</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="Wheels3_1">
  <mu1>1.5</mu1>
  <mu2>1.5</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="Wheels4_1">
  <mu1>1.5</mu1>
  <mu2>1.5</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="Simple-Hand2_1">
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="Simple-Hand_1">
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="Neck_1">
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="Eye-Piece_1">
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="Eye-Piece_other_1">
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="eye_CAM_1">
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="motion_IMU_1">
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
</gazebo>

<ros2_control name="GazeboSimSystem" type="system">
<hardware>
   <plugin>gz_ros2_control/GazeboSimSystem</plugin>
</hardware>
<joint name="RF_Whe">
   <state_interface name="position"/>
   <state_interface name="velocity"/>
   <command_interface name="velocity"/>
</joint>

<joint name="RB_Whe">
   <state_interface name="position"/>
   <state_interface name="velocity"/>
   <command_interface name="velocity"/>
</joint>

<joint name="LF_Whe">
   <state_interface name="position"/>
   <state_interface name="velocity"/>
   <command_interface name="velocity"/>
</joint>

<joint name="LB_Whe">
   <state_interface name="position"/>
   <state_interface name="velocity"/>
   <command_interface name="velocity"/>
</joint>

<joint name="LH">
  <command_interface name="position">
    <param name="min">-0.436332</param>
    <param name="max">1.570796</param>
  </command_interface>
  <command_interface name="velocity">
    <param name="min">10</param>
    <param name="max">100</param>
  </command_interface>
  <state_interface name="position">
    <param name="initial_value">0.0</param>
  </state_interface>
  <state_interface name="velocity">
    <param name="initial_value">0.0</param>
  </state_interface>
  <state_interface name="effort"/>
</joint>

<joint name="RH">
  <command_interface name="position">
    <param name="min">-1.570796</param>
    <param name="max">0.523599</param>
  </command_interface>
  <command_interface name="velocity">
    <param name="min">10</param>
    <param name="max">100</param>
  </command_interface>
  <state_interface name="position">
    <param name="initial_value">0.0</param>
  </state_interface>
  <state_interface name="velocity">
    <param name="initial_value">0.0</param>
  </state_interface>
  <state_interface name="effort"/>
</joint>

<joint name="Ne">
  <command_interface name="position">
    <param name="min">-0.698132</param>
    <param name="max">0.698132</param>
  </command_interface>
  <command_interface name="velocity">
    <param name="min">10</param>
    <param name="max">100</param>
  </command_interface>
  <state_interface name="position">
    <param name="initial_value">0.0</param>
  </state_interface>
  <state_interface name="velocity">
    <param name="initial_value">0.0</param>
  </state_interface>
  <state_interface name="effort"/>
</joint>

<joint name="Le">
  <command_interface name="position">
    <param name="min">0.261799</param>
    <param name="max">0.261799</param>
  </command_interface>
  <command_interface name="velocity">
    <param name="min">10</param>
    <param name="max">100</param>
  </command_interface>
  <state_interface name="position">
    <param name="initial_value">0.0</param>
  </state_interface>
  <state_interface name="velocity">
    <param name="initial_value">0.0</param>
  </state_interface>
  <state_interface name="effort"/>
</joint>

<joint name="Re">
  <command_interface name="position">
    <param name="min">0.523599</param>
    <param name="max">0.523599</param>
  </command_interface>
  <command_interface name="velocity">
    <param name="min">10</param>
    <param name="max">100</param>
  </command_interface>
  <state_interface name="position">
    <param name="initial_value">0.0</param>
  </state_interface>
  <state_interface name="velocity">
    <param name="initial_value">0.0</param>
  </state_interface>
  <state_interface name="effort"/>
</joint>

</ros2_control>
<gazebo>
<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
   <parameters>$(find sim_description)/config/ros2_controller.yaml</parameters>
</plugin>
<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
   <render_engine>ogre2</render_engine>
</plugin>
<plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

<plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
<left_joint>LF_Whe</left_joint>
<left_joint>LB_Whe</left_joint>
<right_joint>RF_Whe</right_joint>
<right_joint>RB_Whe</right_joint>

<wheel_separation>0.25</wheel_separation>
<wheel_radius>0.001</wheel_radius>

<topic>/cmd_vel</topic>
</plugin>
</gazebo>
</robot>
